<Window x:Class="HotelManagement.GUI.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống"
        Height="420"
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F8FB">

    <Grid>

        <Border Width="420"
                Height="320"
                Background="White"
                CornerRadius="18"
                Padding="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F4C5C"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Tên đăng nhập"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <TextBox x:Name="txtUsername"
                         Height="38"
                         FontSize="14"
                         Margin="0,5,0,18"/>

                <TextBlock Text="Mật khẩu"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <Grid Margin="0,5,0,10">

                    <PasswordBox x:Name="txtPassword"
                                 Height="38"
                                 FontSize="14"/>

                    <TextBox x:Name="txtShowPassword"
                             Height="38"
                             FontSize="14"
                             Visibility="Collapsed"/>

                </Grid>

                <CheckBox x:Name="chkShowPassword"
                          Content="Hiện mật khẩu"
                          Margin="0,0,0,15"
                          Checked="chkShowPassword_Checked"
                          Unchecked="chkShowPassword_Unchecked"/>

                <Button x:Name="btnDangNhap"
                        Content="Đăng nhập"
                        Height="42"
                        Background="#0F4C5C"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="15"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <TextBlock Text="Quên mật khẩu?"
                           Foreground="#1E88E5"
                           FontWeight="SemiBold"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Right"
                           Cursor="Hand"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>