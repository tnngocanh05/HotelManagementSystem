<Window x:Class="HotelManagement.GUI.Dialogs.KiemTraPhongDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm tra phòng"
        Height="454"
        Width="1111"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5FBFB">

    <Grid Margin="20,20,10,11">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="KIỂM TRA PHÒNG"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#0F4C5C"
                   Margin="0,0,0,20"/>

        <!-- FORM -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="20" Margin="0,0,0,38" Grid.RowSpan="2">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Mã đặt phòng -->
                <TextBlock Text="Mã đặt phòng:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtMaDatPhong"
                         Grid.Column="1"
                         Margin="5"
                         Height="32"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"/>

                <!-- Nội dung -->
                <TextBlock Text="Nội dung đền bù:"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           Margin="5,0,789,0"
                           FontWeight="SemiBold" Grid.ColumnSpan="2"/>

                <TextBox x:Name="txtNoiDung"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="5"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="14"/>

                <!-- Số tiền -->
                <TextBlock Text="Số tiền đền bù:"
                           Grid.Row="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtSoTien"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="5"
                         Height="32"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- BUTTON -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">

            <Button x:Name="btnLuu"
                    Content="Lưu đền bù"
                    Width="150"
                    Height="38"
                    Margin="10,0"/>

            <Button x:Name="btnDong"
                    Content="Đóng"
                    Width="120"
                    Height="38"
                    Margin="10,0"/>
        </StackPanel>
    </Grid>
</Window>